# Postgres connection string (Neon or any Postgres provider)
DATABASE_URI=

# PEM of the CA that signs the Postgres server certificate. Optional locally: the repo ships
# certs/prod-ca-2021.crt (gitignored) and that file is used when this is unset. Set it on hosts
# where certs/ is not deployed, e.g. Vercel. Certificate verification is always on, so startup
# fails if neither source is available. Note that sslmode / sslrootcert / sslcert / sslkey / ssl
# parameters in DATABASE_URI are stripped and ignored; this CA plus full verification always wins.
DATABASE_SSL_CA=

# Random string, 32+ characters, used to sign Payload's JWTs/cookies
PAYLOAD_SECRET=

# Stripe secret API key (server-side)
STRIPE_SECRET_KEY=

# Stripe publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=

# Resend API key, used for transactional email
RESEND_API_KEY=
# Verified sender address in Resend. REQUIRED whenever RESEND_API_KEY is set — there is no
# fallback sender, and startup fails if this is missing.
RESEND_FROM_EMAIL=

# Inbox for admin notifications: new signups, password-reset alerts, Stripe disputes, contact-form
# and military-discount submissions. No fallback — if unset, those notifications are skipped and
# recorded in the email-logs collection as failed with a reason, rather than sent anywhere.
SUPPORT_EMAIL=

# Optional blind copy of outbound transactional email, for operational oversight. BCC, never CC,
# so it is not visible to the customer. Emails carrying attachments (the military-discount ID
# photo) are deliberately never copied here. Leave empty to send no copies at all.
ADMIN_BCC_EMAIL=

# NextAuth session encryption secret
NEXTAUTH_SECRET=

# Google OAuth (for "Sign in with Google") - create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL NextAuth uses for callbacks, e.g. http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Public site URL, used for canonicals, og:url, JSON-LD, the sitemap, robots.txt and email links.
# REQUIRED: there is deliberately no fallback domain, so the app fails fast if this is unset.
NEXT_PUBLIC_SITE_URL=

# Search-engine indexing is opt-IN. Vercel production deployments set VERCEL_ENV=production and
# are indexed automatically, so the live site needs nothing here. Local dev and preview/staging
# deployments are noindex + robots-disallow. Set this to true ONLY on a non-Vercel production
# host, otherwise a self-hosted launch would stay silently deindexed.
SITE_INDEXABLE=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Cloudflare R2 (S3-compatible) storage for media uploads
# Bucket name, e.g. aminobased-media
R2_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public r2.dev URL (or custom domain) for serving uploaded files directly
R2_PUBLIC_URL=

# Shared secret for the Vercel Cron job that approves affiliate commissions
# (see vercel.json -> /api/cron/process-commissions). The route returns 401 without it, so the
# job silently never runs if this is missing.
CRON_SECRET=

# Only used by `pnpm seed`. Both are required for that script to run; there are no defaults.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
